# Local development settings. Copy this file to backend/.env (which git ignores).
# Real environment variables override anything set here.

# Debug mode: 1 for local development. Must be 0 (or unset) in production.
DJANGO_DEBUG=1
# Any long random string. Required when DJANGO_DEBUG is off.
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGINS=http://localhost:5173

# PostgreSQL connection. Must match the role and database you created.
POSTGRES_DB=yeticode
POSTGRES_USER=yeticode
POSTGRES_PASSWORD=yeticode
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
