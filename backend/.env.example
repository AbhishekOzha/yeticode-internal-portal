# Local development settings. Copy this file to backend/.env (which git ignores)
# and fill in your own database details. Real environment variables override it.

# Debug mode: TRUE for local development. Must be FALSE (or unset) in production.
DEBUG=TRUE
# Any long random string. Required when DEBUG is off.
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGINS=http://localhost:5173

# PostgreSQL connection. DJANGO_DATABASE is the database name.
DJANGO_DATABASE=postgres
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432

# Accounts made by `python manage.py create_default_users`.
# Passwords may be left empty while DEBUG is on (dev password yeticode@123);
# they are required in production.
# Default accounts sign in with their email: admin@, webdev.lead@,
# training.manager@ and production.manager@ this domain.
DEFAULT_EMAIL_DOMAIN=yeticode.com
# Super Admin sign-in; defaults to admin@DEFAULT_EMAIL_DOMAIN.
SYSTEM_USERNAME=
SYSTEM_USER_PASSWORD=
UNIT_ADMIN_PASSWORD=
